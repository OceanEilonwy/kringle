config kringle 'main'
	option enabled '1'
	option port '8787'
	# 'all' interfaces, or 'lan' to listen on the LAN address only
	option listen 'all'
	# Base for links Kringle hands out, e.g. 'http://gifts.example.com:8787'.
	# Empty: use whatever address each browser used.
	option public_url ''
	# Delete groups this many days after they were created
	option keep_days '120'
	option data_dir '/etc/kringle'

	# Email (Services > Kringle > Email in LuCI). mail: '' (off), 'smtp',
	# 'tuta', or 'log' (write emails to the system log instead of sending).
	option mail ''
	option mail_from_name 'Kringle'
	# SMTP. smtp_security: 'tls' (port 465), 'starttls' (587) or 'none'.
	option smtp_host ''
	option smtp_port ''
	option smtp_security 'tls'
	option smtp_user ''
	option smtp_password ''
	# Sender address; empty: smtp_user
	option mail_from ''
	# Tuta: the account Kringle signs in to and sends from
	option tuta_user ''
	option tuta_password ''
