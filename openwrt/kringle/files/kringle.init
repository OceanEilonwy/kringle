#!/bin/sh /etc/rc.common
# Kringle gift swap server. Settings live in /etc/config/kringle (or LuCI:
# Services > Kringle); saving them restarts the service.

START=99
USE_PROCD=1

PROG=/usr/bin/kringle

start_service() {
	local enabled port listen public_url keep_days data_dir addr

	config_load kringle
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get port main port 8787
	config_get listen main listen all
	config_get public_url main public_url ''
	config_get keep_days main keep_days 120
	config_get data_dir main data_dir /etc/kringle

	addr=0.0.0.0
	if [ "$listen" = lan ]; then
		. /lib/functions/network.sh
		network_get_ipaddr addr lan || addr=0.0.0.0
	fi

	mkdir -p "$data_dir"
	chown nobody "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" --addr "$addr:$port" --data "$data_dir/kringle.json" --keep-days "$keep_days"
	[ -n "$public_url" ] && procd_append_param command --public-url "$public_url"
	procd_set_param user nobody
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger kringle
	# In "LAN only" mode the listen address follows the LAN interface.
	procd_add_interface_trigger "interface.*.up" lan /etc/init.d/kringle restart
}
